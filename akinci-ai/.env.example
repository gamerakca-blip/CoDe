# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# AKINCI_MODEL=claude-opus-5-5

# --- Sunucu ---
# PORT=3000
# HOST=0.0.0.0
# Canlıda sitenin dış adresi (iyzico geri dönüş adresi bundan üretilir)
# PUBLIC_BASE_URL=https://akinci.ornek.com
# Nginx/Cloudflare gibi bir ters vekil arkasındaysa
# TRUST_PROXY=1
# HTTPS arkasında çalışıyorsan
# COOKIE_SECURE=true
# DATABASE_PATH=./data/akinci.db

# --- Site sahibi ---
# Bu e-postalar herkese açık kayıtla alınamaz; kayıtta OWNER_SIGNUP_CODE istenir ve süresiz Full verilir.
OWNER_EMAILS=
# Uzun, tahmin edilemez bir kod (ör. openssl rand -hex 16 çıktısı)
OWNER_SIGNUP_CODE=

# --- Yasal sayfalardaki satıcı bilgileri ---
# SELLER_NAME=
# SELLER_ADDRESS=
# SELLER_EMAIL=
# SELLER_PHONE=
# SELLER_TAX=

# --- Ödeme (iyzico) ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Test: https://sandbox-api.iyzipay.com  Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# IYZICO_BUYER_IDENTITY=11111111111
# IYZICO_BUYER_CITY=Istanbul
# IYZICO_BUYER_COUNTRY=Turkey
# IYZICO_BUYER_ADDRESS=...

# Sadece yerel geliştirme: ödeme almadan planı açar. Canlıda KULLANMA.
# PAYMENT_MODE=demo
