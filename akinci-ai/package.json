{
  "name": "akinci-ai",
  "version": "1.0.0",
  "description": "Akıncı AI - Claude tabanlı sohbet uygulaması",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p .",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "express": "^5.3.0",
    "iyzipay": "^2.0.71"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  }
}
